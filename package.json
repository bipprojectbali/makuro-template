{
  "name": "makuro-template",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run --hot server/dev.ts",
    "build": "react-router build",
    "start": "NODE_ENV=production bun run server/prod.ts",
    "typecheck": "react-router typegen && tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "auth:generate": "bunx @better-auth/cli generate --output server/db/auth.schema.ts"
  },
  "dependencies": {
    "@elysiajs/eden": "^1.4.9",
    "@elysiajs/node": "^1.4.5",
    "@elysiajs/static": "^1.4.10",
    "@mantine/core": "^9.6.0",
    "@mantine/form": "^9.6.0",
    "@mantine/hooks": "^9.6.0",
    "@react-router/dev": "^8.3.1",
    "@react-router/node": "^8.3.1",
    "@sinclair/typebox": "^0.34.52",
    "@tanstack/react-query": "^5.102.8",
    "better-auth": "^1.7.3",
    "drizzle-orm": "^0.45.2",
    "elysia": "^1.4.30",
    "isbot": "^5.2.2",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "postgres": "^3.4.9",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.3.1",
    "zod": "^4.5.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "@types/bun": "^1.4.1",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  }
}
