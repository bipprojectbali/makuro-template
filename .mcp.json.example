{
  "mcpServers": {
    "makuro-debug-staging": {
      "type": "http",
      "url": "https://staging.your-app.example.com/api/mcp",
      "headers": {
        "Authorization": "Bearer ${MCP_ADMIN_TOKEN}"
      }
    },
    "makuro-debug-prod": {
      "type": "http",
      "url": "https://your-app.example.com/api/mcp",
      "headers": {
        "Authorization": "Bearer ${MCP_ADMIN_TOKEN}"
      }
    }
  }
}
