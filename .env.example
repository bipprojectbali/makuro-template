# App
NODE_ENV=development
# Note: pick a free port. On this machine :3000 is taken by another container.
PORT=3005
APP_URL=http://localhost:3005

# Database — point at your Postgres instance.
# Leave DATABASE_URL empty (or delete it) to use the bundled local Postgres:
# `bun run dev` / `<binary> start` boot it automatically after `<binary> init`
# (runtime cached in ~/.cache/<package name>/pg, data in ./data/pg).
DATABASE_URL=postgres://makuro:makuro@localhost:5432/makuro
# Separate database for `bun run test` (tests delete rows — never point it at dev/prod data).
# Required with an external DATABASE_URL; in local mode `<db>_test` is created automatically.
# DATABASE_URL_TEST=postgres://makuro:makuro@localhost:5432/makuro_test

# Local Postgres (only when DATABASE_URL is empty, or LOCAL_PG_DIR is set — which forces local mode).
# LOCAL_PG_DIR=./data/pg
# LOCAL_PG_PORT=54329
# Database name in the local cluster; default = package name (sanitized), tests use `<name>_test`.
# LOCAL_PG_DB=
# Unix socket dir (0700, owned by you); default /tmp/<package>-pg-<uid>. Keep it short (macOS limit 103 chars).
# LOCAL_PG_SOCKET_DIR=
# BACKUP_DIR=./backups
# GitHub owner/repo that publishes release binaries (`upgrade`, install.sh); defaults to package.json repository.
# MAKURO_REPO=bipprojectbali/makuro-template

# Object storage (S3-compatible). Leave S3_ENDPOINT empty to use the bundled local
# RustFS: `bun run dev` / `<binary> start` boot it automatically (runtime cached in
# ~/.cache/<package name>/rustfs, data + generated keys in ./data/s3).
# External S3 / R2 / MinIO: fill all four (the bucket must already exist).
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_REGION=us-east-1
# Separate bucket for `bun run test` with external S3 (local mode uses `<bucket>-test`).
# S3_BUCKET_TEST=

# Local storage (only when S3_ENDPOINT is empty).
# LOCAL_S3_DIR=./data/s3
# LOCAL_S3_PORT=54330
# Bucket name; default = package name (sanitized).
# LOCAL_S3_BUCKET=

# Better Auth
# generate a secret: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-run-openssl-rand-base64-32
BETTER_AUTH_URL=http://localhost:3005

# Super admins — comma-separated emails. These accounts are always super-admin
# and can access /dev. Add/remove emails here to grant/revoke (applied on next
# login). Example: SUPER_ADMIN_EMAILS=you@example.com,cofounder@example.com
SUPER_ADMIN_EMAILS=

# MCP debug server — expose /api/mcp for local agent access to logs, DB, and status.
# Leave empty to disable. Generate: openssl rand -hex 32
# Access via:
#   Bearer:     Authorization: Bearer <token>
#   Query param: /api/mcp?mcpAdminToken=<token>  (e.g. for stream URLs)
MCP_ADMIN_TOKEN=

# API rate limit per client IP (sliding window). Defaults: 100 requests / 60000 ms.
# /api/auth/* and /api/mcp (token-protected) are skipped here; /api/auth/* is
# limited by Better Auth's own per-IP limiter in production instead.
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# Trusted reverse proxies — comma-separated IPs and/or CIDRs (IPv4 + IPv6).
# Only when the socket peer matches this list is X-Forwarded-For honoured
# (walked right-to-left, trusted hops skipped; ports stripped; a hop that is
# not a valid IP stops the walk and the socket IP is used; if every hop is
# trusted the left-most one wins). X-Real-IP is used only when X-Forwarded-For
# is absent. Otherwise X-Forwarded-For and X-Real-IP are ignored and the socket
# IP is the client IP. Invalid entries fail boot. 0.0.0.0/0 or ::/0 is allowed
# but logs a boot warning: every client can then spoof its IP.
# Your proxy MUST overwrite X-Real-IP and append to X-Forwarded-For.
#   empty (default)          → app is exposed directly, no proxy trusted
#   127.0.0.1,::1            → behind nginx/caddy on the same host
#   10.0.0.0/8,fd00::/8      → behind a load balancer in your private network
#   <Cloudflare IP ranges>   → behind Cloudflare (https://www.cloudflare.com/ips/)
# WARNING: behind a proxy/LB/Cloudflare you MUST set this, otherwise every
# client appears as the proxy IP and shares one rate-limit bucket.
TRUSTED_PROXIES=
